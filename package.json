{
  "name": "tslean",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript → Lean 4 transpiler under semantic reconstruction",
  "main": "dist/codegen/index.js",
  "types": "dist/codegen/index.d.ts",
  "bin": {
    "tslean": "dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/*.mjs",
    "scripts/*.d.mts",
    "scripts/*.ts",
    "scripts/*.sh",
    "lean/**/*.lean",
    "lean/lakefile.toml",
    "lean/lean-toolchain",
    "lean/lake-manifest.json",
    "spec/differential/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint src/ scripts/*.mjs",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format:check:foundation": "prettier --check 'scripts/*.mjs' 'evidence/*.json' package.json",
    "differential:generate": "bun scripts/generate-differential-manifest.mjs",
    "differential:check": "bun scripts/generate-differential-manifest.mjs --check && bun scripts/check-differential-inventory.mjs",
    "evidence:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-array-shrink-input.json",
    "evidence:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-array-shrink-input.json --check",
    "evidence:array-shrink:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-array-shrink-input.json",
    "evidence:array-shrink:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-array-shrink-input.json --check",
    "evidence:heap-allocation:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-heap-allocation-input.json",
    "evidence:heap-allocation:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-heap-allocation-input.json --check",
    "evidence:ordered-props:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-ordered-props-input.json",
    "evidence:ordered-props:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase2-ordered-props-input.json --check",
    "evidence:differential-compact:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-differential-compact-input.json",
    "evidence:differential-compact:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-differential-compact-input.json --check",
    "evidence:differential:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-differential-input.json",
    "evidence:differential:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-differential-input.json --check",
    "evidence:abstract-ops:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-abstract-ops-input.json",
    "evidence:abstract-ops:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-abstract-ops-input.json --check",
    "evidence:primitive-ops:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-primitive-ops-input.json",
    "evidence:primitive-ops:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-primitive-ops-input.json --check",
    "evidence:arrays:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-arrays-input.json",
    "evidence:arrays:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-arrays-input.json --check",
    "evidence:callable:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-callable-input.json",
    "evidence:callable:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-callable-input.json --check",
    "evidence:execution:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-execution-input.json",
    "evidence:execution:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-execution-input.json --check",
    "evidence:heap:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-heap-input.json",
    "evidence:heap:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-heap-input.json --check",
    "evidence:primitives:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-primitives-input.json",
    "evidence:primitives:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/phase1-primitives-input.json --check",
    "evidence:baseline:generate": "bun scripts/generate-evidence-manifest.mjs --input evidence/baseline-input.json",
    "evidence:baseline:check": "bun scripts/generate-evidence-manifest.mjs --input evidence/baseline-input.json --check",
    "js:trust": "bun scripts/check-js-axioms.mjs --evidence evidence/phase2-array-shrink-input.json",
    "verify": "bun run format:check:foundation && bun run differential:check && bun run js:trust && bun run evidence:check && bun run lint && bun run test && bun run build && cd lean && lake build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "typescript",
    "lean4",
    "transpiler",
    "formal-verification",
    "durable-objects",
    "cloudflare",
    "proof-assistant",
    "compiler"
  ],
  "author": "Ashish Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AshishKumar4/TSLean.git"
  },
  "homepage": "https://github.com/AshishKumar4/TSLean#readme",
  "bugs": {
    "url": "https://github.com/AshishKumar4/TSLean/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.2"
  }
}
