          "family": "array-reduce"
        },
        {
          "id": "foldRight",
          "source": "[1, 2, 3].reduceRight((accumulator, element) => accumulator + \":\" + element, \"start\")",
          "expect": {
            "string": "start:3:2:1"
          },
          "family": "array-reduce-right"
        },
        {
          "id": "any-true",
          "source": "[1, 2].some((element) => element === 2)",
          "expect": {
            "boolean": true
          },
          "family": "array-some"
        },
        {
          "id": "any-false",
          "source": "[1, 2].some((element) => element === 3)",
          "expect": {
            "boolean": false
          },
          "family": "array-some"
        },
        {
          "id": "any-empty",
          "source": "[].some((element) => true)",
          "expect": {
            "boolean": false
          },
          "family": "array-some"
        },
        {
          "id": "all-true",
          "source": "[2, 4].every((element) => element % 2 === 0)",
          "expect": {
            "boolean": true
          },
          "family": "array-every"
        },
        {
          "id": "all-false",
          "source": "[2, 3].every((element) => element % 2 === 0)",
          "expect": {
            "boolean": false
          },
          "family": "array-every"
        },
        {
          "id": "all-empty",
          "source": "[].every((element) => false)",
          "expect": {
            "boolean": true
          },
          "family": "array-every"
        },
        {
          "id": "first",
          "source": "[7, 8][0]",
          "expect": {
            "number": 7
          },
          "family": "array-index"
        },
        {
          "id": "rest",
          "source": "[7, 8, 9].slice(1)",
          "expect": {
            "array": [
              {
                "number": 8
              },
              {
                "number": 9
              }
            ]
          },
          "family": "array-slice"
        },
        {
          "id": "rest-singleton",
          "source": "[7].slice(1)",
          "expect": {
            "array": []
          },
          "family": "array-slice"
        },
        {
          "id": "element-order-preserved",
          "source": "[...[1, 2, 3]].map((element) => element)",
          "expect": {
            "array": [
              {
                "number": 1
              },
              {
                "number": 2
              },
              {
                "number": 3
              }
            ]
          },
          "family": "array-map"
        },
        {
          "id": "spread-appends-two-arrays",
          "source": "[...[1, 2], ...[3]].join(',')",
          "expect": {
            "string": "1,2,3"
          },
          "family": "array-spread-append"
        }
