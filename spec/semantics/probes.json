          },
          "family": "string-spread-astral"
        },
        {
          "id": "spread-empty",
          "source": "[...\"\"].length",
          "expect": {
            "number": 0
          },
          "family": "string-spread-empty"
        }
      ]
    },
    {
      "id": "string.empty-code-unit-length",
      "probes": [
        {
          "id": "empty-string-has-no-code-units",
