            "string": "a,b,c"
          },
          "family": "string-spread-code-points"
        },
        {
          "id": "spread-code-point-count",
          "source": "[...\"abc\"].length",
          "expect": {
            "number": 3
          },
          "family": "string-spread-code-points"
        },
        {
          "id": "spread-astral-is-one-element",
          "source": "[...\"\\u{1f600}\"].length",
          "expect": {
            "number": 1
          },
          "family": "string-spread-astral"
        },
        {
          "id": "spread-astral-keeps-code-point",
          "source": "[...\"\\u{1f600}\"][0].codePointAt(0)",
