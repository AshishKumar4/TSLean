{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tslean.dev/spec/differential/corpus-coverage.schema.json",
  "title": "TSLean corpus differential coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "scenarioIds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "classification": { "const": "model-covered" },
            "scenarioIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "reason"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "classification": { "const": "model-pending" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "tests", "reason"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "classification": { "const": "compiler-only" },
            "tests": { "$ref": "#/$defs/tests" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "tests", "reason"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "classification": { "const": "proof-integrity" },
            "tests": { "$ref": "#/$defs/tests" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "classification", "tests", "reason"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "classification": { "const": "scale" },
            "tests": { "$ref": "#/$defs/tests" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
